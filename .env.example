# 检验业务现场作业系统 - 环境变量样例
# 复制为 .env 并按需修改；禁止硬编码真实密钥到源码

# HTTP 服务端口
PORT=4000

# SQLite 数据库路径（相对项目根目录；默认 data/lab.db）
DATABASE_PATH=data/lab.db

# SSRF 白名单：仅允许访问下列 IP/CIDR 的厂商工单 / 仪器接口
# 多个以逗号分隔；留空则采用内置 deny-by-default 策略（拒绝 RFC1918 / loopback / link-local）
EMBED_ALLOWLIST_CIDR=

# 写回 LIS 通道（替身文件路径）
LIS_WRITEBACK_CHANNEL=data/lis-writeback.ndjson

# 心跳限流（每 (vendor, model) 每秒最多事件数；默认 10/s）
HEARTBEAT_RATE_LIMIT=10

# 管理 API 鉴权（极简 Bearer Token）
AUTH_TOKEN=replace-with-long-random-string

# Embed 描述子热重载数据文件
EMBED_REGISTRY_PATH=data/embed-registry.json